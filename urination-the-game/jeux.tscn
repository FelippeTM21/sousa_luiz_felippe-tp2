[sub_resource type="GDScript" id="GDScript_pjyst"]
script/source = "extends Node

@export var SCORE_GOAL: int = 50
@export_file(\"*.tscn\") var next_scene: String = \"\"

@onready var pause_menu: Control = $CanvasLayer/PauseMenu
@onready var game_over_menu: Control = $CanvasLayer/GameOverMenu
@onready var win_menu: Control = $CanvasLayer/WinMenu
@onready var timer_label: Label = $CanvasLayer/TimerLabel
@onready var pee_gauge: ProgressBar = $CanvasLayer/PeeGauge
@onready var score_label: Label = $CanvasLayer/ScoreLabel
@onready var toilet_hint: Label = $CanvasLayer/ToiletHint

var player: Node = null
var game_timer: Timer
var time_left: float = 60.0
var has_won: bool = false

var door_unlocked: bool = false
var door_layer: TileMapLayer = null
var toilet_layer: TileMapLayer = null

func _ready() -> void:
	
	if pause_menu:
		pause_menu.resume_requested.connect(_resume_game)
		pause_menu.restart_requested.connect(_restart_game)

	if game_over_menu:
		game_over_menu.respawn_requested.connect(_restart_game)

	if win_menu:
		win_menu.respawn_requested.connect(_restart_game)
		win_menu.next_requested.connect(_on_next_level_requested)

	
	game_timer = Timer.new()
	game_timer.one_shot = false
	game_timer.wait_time = 1.0
	add_child(game_timer)
	game_timer.timeout.connect(_on_timer_tick)
	game_timer.start()
	_update_timer_label()

	_style_hud()
	toilet_hint.visible = false

	door_layer = get_tree().get_first_node_in_group(\"door_layer\") as TileMapLayer
	toilet_layer = get_tree().get_first_node_in_group(\"toilet_layer\") as TileMapLayer

	_find_player_and_hook()

func _process(_delta: float) -> void:
	if player == null:
		_find_player_and_hook()
	_check_toilet_hint()

func _find_player_and_hook() -> void:
	if player != null:
		return

	player = get_tree().get_first_node_in_group(\"player\")
	if player == null and get_tree().current_scene:
		player = get_tree().current_scene.find_child(\"CharacterBody2D\", true, false)

	if player:
		
		pee_gauge.min_value = 0
		pee_gauge.max_value = 100
		if \"pee_amount\" in player:
			pee_gauge.value = player.pee_amount
		if player.has_signal(\"pee_amount_changed\"):
			player.connect(\"pee_amount_changed\", _on_pee_amount_changed)

		
		var s: int = 0
		if \"score\" in player:
			s = player.score
		_update_score_label(s)
		if player.has_signal(\"score_changed\"):
			player.connect(\"score_changed\", _on_score_changed)

		
		if player.has_signal(\"toilet_finished\"):
			player.connect(\"toilet_finished\", _on_toilet_finished)

func _on_pee_amount_changed(v: float) -> void:
	pee_gauge.value = v

func _on_score_changed(s: int) -> void:
	_update_score_label(s)
	if not door_unlocked and s >= SCORE_GOAL:
		_unlock_door()

func _unlock_door() -> void:
	door_unlocked = true
	if door_layer and door_layer.has_method(\"clear\"):
		door_layer.clear() 

func _on_timer_tick() -> void:
	time_left -= 1.0
	_update_timer_label()
	if time_left <= 0.0:
		game_timer.stop()
		if _is_won():
			_trigger_win()
		else:
			_show_game_over()

func _is_won() -> bool:
	if has_won:
		return true
	if player and \"score\" in player:
		return player.score >= SCORE_GOAL
	return false

func _trigger_win() -> void:
	has_won = true
	_set_hud_visible(false)
	if win_menu:
		win_menu.open()
	get_tree().paused = true

func _show_game_over() -> void:
	_set_hud_visible(false)
	if game_over_menu:
		game_over_menu.open()
	get_tree().paused = true

func _update_timer_label() -> void:
	var minutes: int = int(time_left) / 60
	var seconds: int = int(time_left) % 60
	timer_label.text = \"%d:%02d\" % [minutes, seconds]

func _update_score_label(s: int) -> void:
	score_label.text = \"%d / %d\" % [s, SCORE_GOAL]

func _unhandled_input(event: InputEvent) -> void:
	if Input.is_action_just_pressed(\"ui_cancel\"):
		if get_tree().paused:
			_resume_game()
		else:
			_pause_game()

func _pause_game() -> void:
	get_tree().paused = true
	if pause_menu:
		pause_menu.open()
	_set_hud_visible(false)

func _resume_game() -> void:
	if pause_menu:
		pause_menu.close()
	get_tree().paused = false
	_set_hud_visible(true)

func _set_hud_visible(v: bool) -> void:
	timer_label.visible = v
	pee_gauge.visible = v
	score_label.visible = v
	if not v:
		toilet_hint.visible = false

func _restart_game() -> void:
	get_tree().paused = false
	get_tree().reload_current_scene()

func _on_next_level_requested() -> void:
	if next_scene != \"\":
		get_tree().paused = false
		get_tree().change_scene_to_file(next_scene)

func _on_toilet_finished() -> void:
	
	if next_scene != \"\":
		get_tree().paused = false
		get_tree().change_scene_to_file(next_scene)
	else:
		
		if not has_won:
			_trigger_win()



func _check_toilet_hint() -> void:
	if player == null or not door_unlocked or toilet_layer == null:
		toilet_hint.visible = false
		return

	if \"using_toilet\" in player and player.using_toilet:
		toilet_hint.visible = false
		return

	var player_pos: Vector2 = player.global_position
	var map_pos: Vector2i = toilet_layer.local_to_map(toilet_layer.to_local(player_pos))
	var tile_data: Variant = toilet_layer.get_cell_tile_data(map_pos)

	if tile_data != null:
		toilet_hint.visible = true
		toilet_hint.text = \"Appuyez sur C\"
	else:
		toilet_hint.visible = false

# ---------- HUD STYLE ----------
func _style_hud() -> void:
	var ls := LabelSettings.new()
	ls.font_size = 28
	ls.font_color = Color(1, 1, 1)
	ls.outline_size = 4
	ls.outline_color = Color(0, 0, 0, 0.85)
	timer_label.label_settings = ls
	score_label.label_settings = ls
	toilet_hint.label_settings = ls
"

